# Copy to .env and adjust. Never commit .env.

# Active environment profile: local | staging | production
E2E_ENV=local

# Execution
E2E_BROWSER=chromium
E2E_HEADLESS=true
E2E_SLOW_MO=0
E2E_WORKERS=
E2E_RETRIES=0
E2E_TIMEOUT_MS=60000
E2E_ACTION_TIMEOUT_MS=15000
E2E_NAVIGATION_TIMEOUT_MS=30000

# ERP tenant UI (multi-tenant: use nip.io host, not localhost)
E2E_ERP_TENANT_SLUG=demo
E2E_ERP_UI_BASE_URL=http://demo.127.0.0.1.nip.io:8002
# For multi-tenant: use tenant UI origin so /api proxy sends correct Host (not loopback 8001)
E2E_ERP_API_BASE_URL=http://demo.127.0.0.1.nip.io:8002/api/v1

# Super Admin (optional cross-app flows)
E2E_SUPERADMIN_UI_BASE_URL=http://127.0.0.1:5173
E2E_SUPERADMIN_API_BASE_URL=http://127.0.0.1:8010/api

# Credentials — use dedicated automation accounts only
E2E_ERP_USERNAME=
E2E_ERP_PASSWORD=
E2E_SUPERADMIN_USERNAME=
E2E_SUPERADMIN_PASSWORD=

# Auth session reuse
E2E_AUTH_STORAGE_STATE=storage/erp-auth.json
E2E_SUPERADMIN_AUTH_STORAGE_STATE=storage/superadmin-auth.json
E2E_SKIP_GLOBAL_SETUP=false

# Reporting & diagnostics
E2E_TRACE=on-first-retry
E2E_VIDEO=retain-on-failure
E2E_SCREENSHOT=only-on-failure
# Keep agendas/tasks created by UI tests on the tenant (skip post-test API cleanup)
E2E_KEEP_TEST_DATA=false
E2E_ENABLE_A11Y=false
E2E_LOG_LEVEL=info

# API testing
E2E_API_TIMEOUT_MS=30000

# Performance monitoring hooks (soft thresholds, ms)
E2E_PERF_NAVIGATION_MS=5000
E2E_PERF_API_MS=3000
