{
  "name": "@maithanerp/testing",
  "version": "1.0.0",
  "private": true,
  "description": "Playwright UI automation for Maithan ERP — Thinkspace Actions",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "postinstall": "playwright install --with-deps chromium",
    "setup": "npm install",
    "start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-stack.ps1",
    "test": "node scripts/run-tests.mjs",
    "test:thinkspace": "node scripts/run-tests.mjs",
    "test:login": "playwright test tests/auth/login --project=chromium-login-guest --grep-invert @server-reject",
    "test:login:mobile-blur": "playwright test tests/auth/login/07-phone-username.ui.spec.ts --project=chromium-login-guest",
    "test:login:server-reject": "playwright test tests/auth/login/07b-phone-submit-server.ui.spec.ts --project=chromium-login-guest",
    "test:login:positive": "playwright test tests/auth/login --project=chromium-login-guest --grep @positive",
    "test:login:negative": "playwright test tests/auth/login --project=chromium-login-guest --grep @negative",
    "test:positive": "playwright test tests/thinkspace/workflow tests/thinkspace/projects --project=erp-authenticated --grep @positive",
    "test:negative": "playwright test tests/thinkspace/workflow tests/thinkspace/projects --project=erp-authenticated --grep @negative",
    "test:playwright": "playwright test tests/thinkspace/workflow tests/thinkspace/projects --project=erp-authenticated",
    "test:projects": "playwright test tests/thinkspace/projects --project=erp-authenticated",
    "test:projects:positive": "playwright test tests/thinkspace/projects --project=erp-authenticated --grep @positive",
    "test:projects:negative": "playwright test tests/thinkspace/projects --project=erp-authenticated --grep @negative",
    "test:headed": "playwright test tests/thinkspace/workflow --project=erp-authenticated --headed",
    "test:ui": "playwright test tests/thinkspace/workflow --project=erp-authenticated --ui",
    "test:debug": "playwright test tests/thinkspace/workflow --project=erp-authenticated --debug",
    "test:ci": "cross-env CI=true playwright test tests/thinkspace/workflow --project=erp-authenticated",
    "demo:thinkspace-action": "node scripts/demo-thinkspace-action.mjs",
    "demo:thinkspace-projects": "node scripts/demo-thinkspace-projects.mjs",
    "report": "playwright show-report",
    "report:allure": "python scripts/allure_report.py",
    "report:allure:open": "python scripts/allure_report.py --open",
    "report:allure:serve": "python scripts/allure_report.py --serve",
    "codegen": "playwright codegen",
    "install:browsers": "playwright install --with-deps chromium",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "@types/node": "^22.15.21",
    "allure-commandline": "^2.42.1",
    "allure-playwright": "^3.10.0",
    "cross-env": "^7.0.3",
    "dotenv": "^16.5.0",
    "typescript": "^5.8.3",
    "winston": "^3.17.0",
    "zod": "^3.25.28"
  }
}
